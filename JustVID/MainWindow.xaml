<Window x:Class="JustVID.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JustVID" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="JustVID" Width="960" Height="620" MinWidth="160" MinHeight="140" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" Icon="Assets/JustVID.ico" AllowDrop="True" Drop="FileDrop" PreviewKeyDown="KeyDownHandler">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="6" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="VideoBackground" Color="#101214"/><SolidColorBrush x:Key="Surface" Color="#17191C"/><SolidColorBrush x:Key="Ink" Color="#F3F4F5"/><SolidColorBrush x:Key="Muted" Color="#9CA3AB"/><SolidColorBrush x:Key="TrackColor" Color="#3A3E44"/><SolidColorBrush x:Key="Hover" Color="#30353A"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinWidth" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="MinHeight" Value="24"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="5,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#32C777"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="10" Height="10"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Ink}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource TrackColor}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Margin="12,0,4,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M0,0 L0,16 L14,8 Z" Fill="#32C777" Width="14" Height="16"/><TextBlock Text="JustVID" Margin="9,0" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <TextBlock x:Name="FileName" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Click="Minimize" ToolTip="최소화 / Minimize"/><Button Content="□" Click="Maximize" ToolTip="최대화 / Maximize"/><Button Content="✕" Click="CloseWindow" ToolTip="닫기 / Close"/></StackPanel>
  </Grid>
  <Grid x:Name="VideoArea" Grid.Row="1" Background="{DynamicResource VideoBackground}" ClipToBounds="True" SizeChanged="LayoutVideo">
   <local:VideoEngineView x:Name="Player" Visibility="Hidden" HorizontalAlignment="Left" VerticalAlignment="Top" MediaOpened="MediaOpened" MediaEnded="MediaEnded" MediaFailed="MediaFailed">
    <Grid x:Name="InputArea" Focusable="True" AllowDrop="True" Drop="FileDrop" Background="#01000000" MouseLeftButtonDown="VideoDown" MouseMove="VideoMove" MouseLeftButtonUp="VideoUp" MouseRightButtonDown="VideoRight" LostMouseCapture="SelectionLost" PreviewKeyDown="KeyDownHandler">
     <Canvas IsHitTestVisible="False"><Border x:Name="Selection" Visibility="Collapsed" BorderBrush="#32C777" BorderThickness="1" Background="#2832C777"/></Canvas>
    </Grid>
   </local:VideoEngineView>
   <Button x:Name="OpenHint" Content="파일 열기 / Open file" HorizontalAlignment="Center" VerticalAlignment="Center" Click="OpenClick"/>
  </Grid>
  <Grid Grid.Row="2" Margin="12,5,12,10">
   <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Slider x:Name="Timeline" Maximum="1" ValueChanged="SeekChanged" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" MouseMove="PreviewMove" MouseLeave="PreviewLeave" IsEnabled="False" AutomationProperties.Name="재생 위치 / Playback position"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶" Click="ToggleClick" ToolTip="재생/일시정지 (Space)"/><Button Content="＋" Click="OpenClick" ToolTip="파일 열기 (Ctrl+O)"/><TextBlock x:Name="Clock" Text="0:00 / 0:00" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="7,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="MuteButton" Click="MuteClick" ToolTip="음소거 (M)"><Grid Width="20" Height="20"><Path Data="M2,7 L6,7 L11,3 L11,17 L6,13 L2,13 Z" Fill="{DynamicResource Ink}"/><Path x:Name="VolumeLow" Data="M14,6 Q18,10 14,14" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path x:Name="VolumeHigh" Data="M16,3 Q23,10 16,17" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path x:Name="VolumeOff" Data="M14,7 L19,12 M19,7 L14,12" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Visibility="Collapsed"/></Grid></Button><Slider x:Name="Volume" Width="72" Maximum="1" Value="0.65" ValueChanged="VolumeChanged" AutomationProperties.Name="볼륨 / Volume"/><Button Content="◐" Click="ThemeClick" ToolTip="테마 / Theme"/><Button Content="⛶" Click="FullscreenClick" ToolTip="전체 화면 (F)"/></StackPanel>
   </Grid>
  </Grid>
  <Popup x:Name="PreviewPopup" PlacementTarget="{Binding ElementName=Timeline}" Placement="Relative" AllowsTransparency="True" IsHitTestVisible="False" PopupAnimation="None">
   <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource TrackColor}"><StackPanel><Grid Width="168" Height="95" Background="Black"><local:VideoEngineView x:Name="PreviewPlayer" IsMuted="True" PreviewMode="True" MediaOpened="PreviewOpened" MediaFailed="PreviewFailed"><TextBlock x:Name="PreviewStatus" Text="…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></local:VideoEngineView></Grid><TextBlock x:Name="PreviewTime" HorizontalAlignment="Center" Margin="0,4,0,1" Foreground="{DynamicResource Ink}" FontSize="11"/></StackPanel></Border>
  </Popup>
 </Grid>
</Window>
