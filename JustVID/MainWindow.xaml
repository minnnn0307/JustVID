<Window x:Class="JustVID.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JustVID" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="JustVID" Width="960" Height="620" MinWidth="160" MinHeight="140" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" Icon="Assets/JustVID.ico" AllowDrop="True" Drop="FileDrop" PreviewKeyDown="KeyDownHandler">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="6" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/JustVID;component/Assets/Brand.xaml" /></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="TimeSurface" Color="#282E34"/><SolidColorBrush x:Key="ControlInk" Color="#F3F4F5"/><SolidColorBrush x:Key="ControlSurface" Color="#17191C"/><SolidColorBrush x:Key="ThumbEdge" Color="#68717C"/><SolidColorBrush x:Key="Card" Color="#20242A"/><SolidColorBrush x:Key="VideoBackground" Color="#101214"/><SolidColorBrush x:Key="Surface" Color="#17191C"/><SolidColorBrush x:Key="Ink" Color="#F3F4F5"/><SolidColorBrush x:Key="Muted" Color="#9CA3AB"/><SolidColorBrush x:Key="TrackColor" Color="#3A3E44"/><SolidColorBrush x:Key="Hover" Color="#30353A"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinWidth" Value="28"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ThemeChoice" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="6"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource Muted}" Opacity="0.45"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Slider">
   <Setter Property="MinHeight" Value="24"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="5,0" Background="Transparent"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#32C777"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="20" Height="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ControlInk}" Stroke="{DynamicResource ThumbEdge}" StrokeThickness="0.7"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource TrackColor}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="RootLayout">
  <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Margin="12,0,4,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="TitleBrand" Orientation="Horizontal" VerticalAlignment="Center"><Path Data="{StaticResource PlayMarkGeometry}" Stretch="Fill" Fill="{StaticResource BrandGreen}" Width="14" Height="16"/><TextBlock Text="JustVID" Margin="9,0" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <TextBlock x:Name="FileName" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Click="SettingsClick" ToolTip="설정 / Settings (Ctrl+,)"><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Foreground="{DynamicResource Ink}"/></Button>
    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize" ToolTip="최소화 / Minimize"><Path Width="12" Height="12" Data="M1,6 L11,6" Stroke="{DynamicResource Ink}" StrokeThickness="1.4"/></Button>
    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize" ToolTip="최대화 / Maximize"><Path Width="12" Height="12" Data="M1.5,1.5 L10.5,1.5 L10.5,10.5 L1.5,10.5 Z" Stroke="{DynamicResource Ink}" StrokeThickness="1.3"/></Button>
    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="CloseWindow" ToolTip="닫기 / Close"><Path Width="12" Height="12" Data="M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource Ink}" StrokeThickness="1.4"/></Button>
   </StackPanel>
  </Grid>
  <Grid x:Name="VideoArea" Grid.Row="1" Background="{DynamicResource VideoBackground}" ClipToBounds="True" SizeChanged="LayoutVideo">
   <local:VideoEngineView x:Name="Player" Visibility="Hidden" HorizontalAlignment="Left" VerticalAlignment="Top" MediaOpened="MediaOpened" MediaEnded="MediaEnded" MediaFailed="MediaFailed">
    <Grid x:Name="InputArea" Focusable="True" AllowDrop="True" Drop="FileDrop" Background="#01000000" MouseLeftButtonDown="VideoDown" MouseMove="VideoMove" MouseLeftButtonUp="VideoUp" MouseRightButtonDown="VideoRight" LostMouseCapture="SelectionLost" PreviewKeyDown="KeyDownHandler">
     <Canvas IsHitTestVisible="False"><Border x:Name="Selection" Visibility="Collapsed" BorderBrush="#32C777" BorderThickness="1" Background="#2832C777"/></Canvas>
    </Grid>
   </local:VideoEngineView>
   <Viewbox x:Name="EmptyLogo" MaxWidth="230" MaxHeight="60" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlayMarkGeometry}" Stretch="Fill" Fill="{StaticResource BrandGreen}" Width="38" Height="44"/><TextBlock Text="JustVID" Foreground="{DynamicResource Ink}" FontSize="34" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel>
   </Viewbox>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource ControlSurface}"/>
  <Grid x:Name="ControlBar" Grid.Row="2" Margin="12,5,12,10" PreviewKeyDown="KeyDownHandler">
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <Slider x:Name="Timeline" Height="32" Background="Transparent" Maximum="1" ValueChanged="SeekChanged" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" LostMouseCapture="SeekCaptureLost" MouseMove="PreviewMove" MouseLeave="PreviewLeave" IsEnabled="False" AutomationProperties.Name="재생 위치 / Playback position"/>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Click="ToggleClick" ToolTip="재생/일시정지 (Space)"><Grid Width="14" Height="16"><Path x:Name="PlaySymbol" Data="{StaticResource PlayMarkGeometry}" Stretch="Fill" Fill="{StaticResource BrandGreen}"/><Path x:Name="PauseSymbol" Data="M3,2 L3,14 M11,2 L11,14" Stroke="{DynamicResource ControlInk}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Grid></Button><Button x:Name="StopButton" Click="StopClick" IsEnabled="False" ToolTip="완전 정지 / Stop"><Rectangle Width="12" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource ControlInk}"/></Button><Button Content="＋" Foreground="{DynamicResource ControlInk}" Click="OpenClick" ToolTip="파일 열기 (Ctrl+O)"/><Border x:Name="ClockBadge" Background="{DynamicResource TimeSurface}" CornerRadius="6" Padding="9,5" Margin="7,0" VerticalAlignment="Center"><TextBlock x:Name="Clock" Text="0:00 / 0:00" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/></Border></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="MuteButton" Click="MuteClick" ToolTip="음소거 (M)"><Grid Width="20" Height="20"><Path Data="M2,7 L6,7 L11,3 L11,17 L6,13 L2,13 Z" Fill="{DynamicResource ControlInk}"/><Path x:Name="VolumeLow" Data="M14,6 Q18,10 14,14" Stroke="{DynamicResource ControlInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path x:Name="VolumeHigh" Data="M16,3 Q23,10 16,17" Stroke="{DynamicResource ControlInk}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path x:Name="VolumeOff" Data="M14,7 L19,12 M19,7 L14,12" Stroke="{DynamicResource ControlInk}" StrokeThickness="1.5" Visibility="Collapsed"/></Grid></Button><Slider x:Name="Volume" Width="72" Maximum="1" Value="0.65" ValueChanged="VolumeChanged" AutomationProperties.Name="볼륨 / Volume"/><Button Foreground="{DynamicResource ControlInk}" Content="⛶" Click="FullscreenClick" ToolTip="전체 화면 (F)"/></StackPanel>
   </Grid>
  </Grid>
  <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=RootLayout}" Placement="Relative" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None">
   <Grid x:Name="SettingsBackdrop" Background="#66000000" MouseLeftButtonDown="SettingsBackdropClick" PreviewKeyDown="SettingsKeyDown">
    <Border x:Name="SettingsCard" Width="520" MaxHeight="560" Padding="24" Background="{DynamicResource Card}" BorderBrush="{DynamicResource TrackColor}" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="설정 / Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/><Button x:Name="SettingsCloseButton" HorizontalAlignment="Right" Width="30" Height="30" Padding="0" Click="SettingsCloseClick" ToolTip="닫기 / Close"><Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" Stroke="{DynamicResource Ink}" StrokeThickness="1.4"/></Button></Grid>
      <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10" Padding="4" Margin="0,20,0,20"><UniformGrid Columns="3"><Button x:Name="AppearanceTab" Content="화면 / Appearance" Click="AppearanceClick" Padding="4,8"/><Button x:Name="InfoTab" Content="영상 정보 / Media info" Click="InfoClick" Padding="4,8"/><Button x:Name="SubtitleTab" Content="자막 / Subtitles" Click="SubtitleClick" Padding="4,8"/></UniformGrid></Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Grid>
        <StackPanel x:Name="AppearancePanel">
         <TextBlock Text="테마 / Theme" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" Margin="0,0,0,12"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="LightThemeChoice" Style="{StaticResource ThemeChoice}" Click="LightThemeClick" Padding="0"><Border x:Name="LightThemeOutline" BorderBrush="{DynamicResource TrackColor}" BorderThickness="1" CornerRadius="10" Padding="14" Background="#E7EAED"><StackPanel><Grid Height="50"><Border VerticalAlignment="Bottom" Height="12" Background="#D3DAE1" CornerRadius="3"/><Path Data="{StaticResource PlayMarkGeometry}" Fill="{StaticResource BrandGreen}" Stretch="Fill" Width="17" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Grid><TextBlock Text="라이트 / Light" Foreground="#303840" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border></Button>
          <Button x:Name="DarkThemeChoice" Style="{StaticResource ThemeChoice}" Grid.Column="2" Click="DarkThemeClick" Padding="0"><Border x:Name="DarkThemeOutline" BorderBrush="{StaticResource BrandGreen}" BorderThickness="1" CornerRadius="10" Padding="14" Background="#101214"><StackPanel><Grid Height="50"><Border VerticalAlignment="Bottom" Height="12" Background="#30353A" CornerRadius="3"/><Path Data="{StaticResource PlayMarkGeometry}" Fill="{StaticResource BrandGreen}" Stretch="Fill" Width="17" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/></Grid><TextBlock Text="다크 / Dark" Foreground="#F3F4F5" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Border></Button>
         </Grid>
        </StackPanel>
        <StackPanel x:Name="SubtitlePanel" Visibility="Collapsed">
         <TextBlock Text="자막 모양 / Subtitle appearance" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,0,0,12"/>
         <Border Height="72" Background="#15191D" CornerRadius="10" Padding="8" Margin="0,0,0,10"><TextBlock x:Name="SubtitleSample" Text="자막 미리보기" Foreground="White" FontWeight="SemiBold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Border>
         <Grid><TextBlock Text="크기 / Size" Foreground="{DynamicResource Ink}"/><TextBlock x:Name="SubtitleSizeLabel" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
         <Slider x:Name="SubtitleSize" Minimum="50" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SubtitleDraftChanged" Margin="0,4,0,8" AutomationProperties.Name="자막 크기 / Subtitle size"/>
         <Grid><TextBlock Text="아래에서 높이 / Bottom margin" Foreground="{DynamicResource Ink}"/><TextBlock x:Name="SubtitleMarginLabel" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
         <Slider x:Name="SubtitleMargin" Minimum="0" Maximum="300" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SubtitleDraftChanged" Margin="0,4,0,8" AutomationProperties.Name="자막 위치 / Subtitle position"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SubtitleFileLabel" Text="내장 자막 또는 자동 검색 자막" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="자막 파일 열기" Click="SubtitleFileClick" Background="{DynamicResource Hover}"/></Grid>
         <TextBlock Text="텍스트 자막에 적용됩니다. 영상에 박힌 자막과 이미지 자막의 글꼴 크기는 변경되지 않습니다." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,8"/>
         <Button x:Name="SubtitleApplyButton" Style="{StaticResource PrimaryButton}" Content="적용 / Apply" Click="SubtitleApplyClick" Background="{StaticResource BrandGreen}" Foreground="#12351F" HorizontalAlignment="Right" Padding="22,8"/>
        </StackPanel>
        <StackPanel x:Name="InfoPanel" Visibility="Collapsed">
         <TextBlock x:Name="InfoEmpty" Text="열려 있는 영상이 없습니다. / No video open." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
         <ItemsControl x:Name="InfoSections"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandGreen}" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0"/><TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" FontSize="12" Padding="0" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </Grid>
      </ScrollViewer>
      <TextBlock x:Name="SettingsAbout" Grid.Row="3" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,20,0,0"/>
     </Grid>
    </Border>
   </Grid>
  </Popup>
  <Popup x:Name="FullscreenControls" PlacementTarget="{Binding ElementName=RootLayout}" Placement="Relative" StaysOpen="True" AllowsTransparency="False" PopupAnimation="None">
   <Border x:Name="FullscreenControlHost" MouseLeave="FullscreenControlsLeave" Background="{DynamicResource ControlSurface}" />
  </Popup>
  <Popup x:Name="PreviewPopup" PlacementTarget="{Binding ElementName=Timeline}" Placement="Relative" AllowsTransparency="True" IsHitTestVisible="False" PopupAnimation="None">
   <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource TrackColor}"><StackPanel><Grid Width="168" Height="95" Background="Black"><local:VideoEngineView x:Name="PreviewPlayer" IsMuted="True" PreviewMode="True" MediaOpened="PreviewOpened" MediaFailed="PreviewFailed"><TextBlock x:Name="PreviewStatus" Text="…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></local:VideoEngineView></Grid><TextBlock x:Name="PreviewTime" HorizontalAlignment="Center" Margin="0,4,0,1" Foreground="{DynamicResource Ink}" FontSize="11"/></StackPanel></Border>
  </Popup>
 </Grid>
</Window>
